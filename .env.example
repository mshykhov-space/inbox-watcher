# Inbox Watcher local config. Copy to .env and fill in. Never commit .env.

# Gmail API OAuth (scope gmail.readonly) - see docs/setup/gmail.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# AI: choose one provider or an ordered fallback chain. See docs/setup/ai-providers.md.
# AI_PROVIDERS=gemini,groq
# AI_PROVIDERS=openrouter
# AI_PROVIDERS=ollama
# AI_PROVIDERS=custom,groq

# Legacy mode when AI_PROVIDERS is unset: Gemini (if key exists), optional Cerebras, Groq.
GEMINI_API_KEY=
# GEMINI_ENABLED=true
# GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
# CEREBRAS_ENABLED=false
# CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter free router: create a key at https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_RESPONSE_FORMAT=json_object

# OpenAI and Anthropic: select a model available to your API account.
# OPENAI_API_KEY=
# OPENAI_MODEL=your-model-id
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=your-model-id
# ANTHROPIC_MAX_TOKENS=1024

# Ollama: installed local model, no API key needed.
# OLLAMA_MODEL=your-installed-model
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Docker Desktop host: http://host.docker.internal:11434/v1

# Any compatible API: replace CUSTOM with the name in AI_PROVIDERS (uppercase).
# All providers accept these overrides; built-in defaults are in docs/setup/ai-providers.md.
# CUSTOM_API_TYPE=openai
# CUSTOM_BASE_URL=https://your-provider.example/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=your-model-id
# CUSTOM_AUTH_REQUIRED=true
# CUSTOM_RESPONSE_FORMAT=json_object
# Response formats for OpenAI APIs: json_schema, json_object, none (prompt only).
# CUSTOM_REASONING_EFFORT=none
# Only APIs supporting thinking.type, e.g. Z.ai GLM-4.5-Flash:
# CUSTOM_THINKING=disabled

# Independent free fallback example: AI_PROVIDERS=groq,zai
# ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.5-flash
# ZAI_THINKING=disabled
# Set AUTH_REQUIRED=false only for an endpoint that works without a key.
# Free API directories:
# https://github.com/abbosaliboev/free-ai-bible
# https://github.com/open-free-llm-api/awesome-freellm-apis
# https://github.com/startupmini/FLA (maintained fork, Indonesian)

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime (optional - defaults shown)
# STATE_DB_PATH=/state/inbox-watcher.db   # local development: ./data/inbox-watcher.db
# HTTP_PORT=8080
# POLL_INTERVAL_SECONDS=60
# SILENCE_ALERT_HOURS=12
# PUBLIC_BASE_URL=https://mail.example.test   # enables the "Приложение" redirect link
